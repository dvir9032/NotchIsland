            "value": "אי דינמי"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האי קורא את הכתובת של הכרטיסייה הפתוחה בספארי כדי לשלוח אותה ב-AirDrop או לשמור אותה במדף."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האי מראה כשאוזניות ומכשירי בלוטות' מתחברים, ואת הסוללה שלהם."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המראה בנוצ' מציגה את המצלמה הקדמית רק כשאתה פותח אותה."
          }
        }
      }
    }
  }
}